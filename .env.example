# Copy to .env and edit. NEVER commit .env.
# ---- Database ----
POSTGRES_USER=careerforge
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=careerforge
DATABASE_URL=postgresql+psycopg://careerforge:change-me-locally@db:5432/careerforge

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0

# ---- App ----
APP_ENV=development
APP_SECRET_KEY=generate-with-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:3000
STORAGE_DIR=/app/storage

# ---- AI (optional; keyword mode works without it) ----
AI_PROVIDER=none            # none | anthropic
ANTHROPIC_API_KEY=
AI_MODEL=

# ---- Job sources (optional; each source is skipped if unset) ----
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ---- Email (Checkpoint 5) ----
EMAIL_PROVIDER=smtp         # smtp | resend
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=
